# ==========================================
# Hassan Personal AI Agent - Configuration
# ==========================================

# 🔑 Gemini API Key (از اینجا بگیر: https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=your_gemini_api_key_here

# ⚡ Groq API Key (رایگان، پرسرعت، بدون قطعی: https://console.groq.com/keys)
GROQ_API_KEY=

# 🌐 OpenRouter API Key (دسترسی به DeepSeek و Llama: https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 🤖 Telegram Bot (از @BotFather در تلگرام)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# آی‌دی تلگرام خودت (از @userinfobot بگیر)
TELEGRAM_OWNER_ID=drapman4L

# 📧 Email Configuration (Gmail)
EMAIL_USER=your_email@gmail.com
# برای Gmail باید App Password بسازی (نه پسورد اصلی)
# رفتن به: myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com

# 🌐 Website API (اگه سایتت API داره)
SITE_API_URL=https://yoursite.com/api
SITE_API_KEY=your_site_api_key

# 🗄️ Database
DB_PATH=./data/agent.db

# 📱 Telegram Mini App URL (HTTPS)
WEBAPP_URL=https://your-domain.com

